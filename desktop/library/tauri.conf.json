{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Recomp Toolkit",
  "version": "0.1.0",
  "identifier": "dev.recomptoolkit.app",
  "build": { "frontendDist": "../../web/library" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "Recomp Toolkit", "width": 1100, "height": 760, "minWidth": 720, "minHeight": 540 }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:" }
  },
  "bundle": { "active": false }
}
